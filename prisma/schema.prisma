generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(120)
  usuario   String    @unique @db.VarChar(60)
  funcao    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  projects  Project[] @relation("ProfileProjects")

  @@map("profiles")
}

model Technology {
  id                  Int                 @id @default(autoincrement())
  nome                String              @unique @db.VarChar(80)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at")
  projectTechnologies ProjectTechnology[]

  @@map("technologies")
}

model Project {
  id                  Int                 @id @default(autoincrement())
  profileId           Int
  titulo              String              @db.VarChar(160)
  descricao           String?
  url_repositorio     String?             @db.VarChar(500)
  url_demonstracao    String?             @db.VarChar(500)
  upvotes             Int                 @default(0)
  notaMedia           Float               @default(0) @map("nota_media")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at")
  profile             Profile             @relation("ProfileProjects", fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  feedbacks           Feedback[]
  projectTechnologies ProjectTechnology[]

  @@index([profileId])
  @@map("projects")
}

model Feedback {
  id         Int      @id @default(autoincrement())
  projetoId  Int
  autor      String   @db.VarChar(120)
  nota       Int
  comentario String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  project    Project  @relation(fields: [projetoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projetoId])
  @@map("feedbacks")
}

model ProjectTechnology {
  id_projeto    Int        @map("id_projeto")
  id_tecnologia Int        @map("id_tecnologia")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")
  project       Project    @relation(fields: [id_projeto], references: [id], onDelete: Cascade, onUpdate: Cascade)
  technology    Technology @relation(fields: [id_tecnologia], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([id_projeto, id_tecnologia])
  @@map("project_technologies")
}